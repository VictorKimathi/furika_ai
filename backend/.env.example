FLASK_APP=run.py
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://furika:furika@localhost:5432/furika
CORS_ORIGINS=http://localhost:5173
# Server-only Gemini credentials. Never expose this key through a VITE_ variable.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Where original uploads are kept. Defaults to backend/storage (git-ignored).
STORAGE_ROOT=
# Server-side Google key for the Geocoding API (separate from the browser Maps key; restrict by IP/API).
GOOGLE_MAPS_API_KEY=
