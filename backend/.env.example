FLASK_APP=run.py
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://furika:furika@localhost:5432/furika
CORS_ORIGINS=http://localhost:5173
# Server-only Claude key used for upload parsing and first in the chat provider order.
# Never expose it through a VITE_ variable.
ANTHROPIC_API_KEY=
# Optional alternative name for an existing Anthropic API key used by Claude Code.
CLAUDE_CODE=
# Optional: override the Claude model (default claude-opus-5-5 for parsing).
CLAUDE_MODEL=
# Chat tries Claude, then Gemini, then OpenAI GPT-5.6 Luna.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Add your OpenAI key to backend/.env, never to a VITE_ frontend variable.
OPENAI_API_KEY=
# The chat fallback uses this model first; OPENAI_MODEL is also supported for older configurations.
RISK_ATLAS_OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL=gpt-5.6-luna
# Where original uploads are kept. Defaults to backend/storage (git-ignored).
STORAGE_ROOT=
# Server-side Google key for the Geocoding API (separate from the browser Maps key; restrict by IP/API).
GOOGLE_MAPS_API_KEY=
# Approved model reports are emailed to this owner after the human approval gate.
REPORT_OWNER_EMAIL=
REPORT_EMAIL_ENABLED=true
# SMTP sender settings (server-side only). Use provider-issued SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
