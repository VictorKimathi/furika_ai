# Browser key: restrict it to your site origins and enable Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-only secret. Never rename this with a VITE_ prefix.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: change this to a model available to your OpenAI project.
OPENAI_MODEL=gpt-5-mini
